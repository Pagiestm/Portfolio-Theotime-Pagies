{
  "name": "portfolio-theotime-pagies",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio de Théotime Pagies — site (apps/web), back-office Sanity (apps/studio), code partagé (packages/shared)",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@portfolio/web",
    "dev:studio": "turbo run dev --filter=@portfolio/studio",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run preview -w @portfolio/web",
    "deploy:studio": "npm run deploy -w @portfolio/studio",
    "migrate": "npm run migrate -w @portfolio/studio",
    "migrate:dry": "npm run migrate:dry -w @portfolio/studio",
    "prepare": "husky || echo \"husky absent : hooks Git non installés (build distant)\""
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "turbo": "^2.5.8"
  }
}
