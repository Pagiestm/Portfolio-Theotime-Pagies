# Copier en `.env` dans ce dossier. Le site se lance depuis la racine : `npm run dev`.

# Sanity - identifiants publics, exposés au navigateur par `envPrefix` (vite.config.ts).
SANITY_PROJECT_ID=svhdk2l2
SANITY_DATASET=production

# EmailJS - formulaire de contact.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_USER_ID=

# reCAPTCHA v2 - clé de site.
VITE_RECAPTCHA_SITE_KEY=

# Assistant - clé Gemini, lue uniquement par la fonction serveur `api/ask.ts`.
# Jamais de préfixe VITE_ : elle ne doit pas atteindre le bundle.
GEMINI_API_KEY=
# Obligatoire : les modèles interrogés, du préféré au dernier recours. Le premier
# qui répond gagne ; celui qui épuise son quota est sauté. Aucun modèle n'est
# écrit dans le code : en changer ne demande aucun déploiement.
#
# L'ordre suit le quota journalier, pas la puissance : les deux « flash-lite »
# de tête acceptent 500 requêtes par jour là où un « flash » s'arrête à 20.
# Pour reformuler un contexte déjà fourni en 120 mots, la différence de qualité
# ne se voit pas ; la différence de capacité, si. Les modèles Pro sont absents :
# ils ne sont pas offerts par le palier sans frais.
LLM_MODELS=google:gemini-3.5-flash-lite,google:gemini-3.1-flash-lite,google:gemini-3.8-flash,google:gemini-3.7-flash,google:gemini-3.6-flash,google:gemini-3.5-flash,google:gemini-2.5-flash,google:gemini-2.5-flash-lite,google:gemini-3-flash-preview
# Optionnel : un fournisseur au format OpenAI en secours (OpenRouter, Groq...).
# Les deux vont ensemble : sans LLM_BASE_URL, le modèle est ignoré.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
