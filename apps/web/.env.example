# Copier en `.env` dans ce dossier. Le site se lance depuis la racine : `npm run dev`.

# Sanity - identifiants publics, exposés au navigateur par `envPrefix` (vite.config.ts).
SANITY_PROJECT_ID=svhdk2l2
SANITY_DATASET=production

# EmailJS - formulaire de contact.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_USER_ID=

# reCAPTCHA v2 - clé de site.
VITE_RECAPTCHA_SITE_KEY=

# Assistant - clé Gemini, lue uniquement par la fonction serveur `api/ask.ts`.
# Jamais de préfixe VITE_ : elle ne doit pas atteindre le bundle.
GEMINI_API_KEY=
# Optionnel : modèle utilisé (défaut : gemini-3.6-flash, le modèle rapide courant de Google).
# GEMINI_MODEL=gemini-3.6-flash
