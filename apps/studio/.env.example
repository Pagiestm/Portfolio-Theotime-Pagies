# Identifiants du projet Sanity — visibles dans sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Jeton d'écriture, uniquement pour le script de migration (npm run migrate).
# À créer dans sanity.io/manage > API > Tokens, avec le rôle « Editor ».
# Ne jamais commiter ce fichier.
SANITY_WRITE_TOKEN=
