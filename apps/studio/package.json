{
  "name": "@portfolio/studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Le back-office Sanity. Embarque son propre React 19 (exigé par Sanity 6), indépendamment du site en React 18.",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "preview": "sanity preview",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "deploy": "sanity deploy",
    "migrate": "sanity exec scripts/migrate-cli.mjs --with-user-token",
    "migrate:dry": "sanity exec scripts/migrate-cli.mjs --with-user-token -- --dry-run"
  },
  "dependencies": {
    "@portfolio/shared": "*",
    "@sanity/vision": "^6.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^6.12.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@sanity/client": "^8.5.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
