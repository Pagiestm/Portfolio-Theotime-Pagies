{
  "name": "@portfolio/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "L'API du portfolio : l'assistant qui répond aux visiteurs à partir du contenu Sanity. Hono, déployée en fonction Vercel par le site, servie par Vite en développement.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
